  <data name="pnlAllSettings.InitScript" xml:space="preserve">
    <value>// Create a new style element
var styleElement = document.createElement('style');

// Define the CSS rules
var css = `
    div.qx-checkbox-icon-checked {
        background-image: url('data:image/svg+xml;base64,') !important;
    }
    div.qx-checkbox-icon-hovered-checked {
        background-image: url('data:image/svg+xml;base64,') !important;
    }
`;

// Add the CSS rules to the style element
styleElement.innerHTML = css;

// Append the style element to the body of the document
document.body.appendChild(styleElement);</value>
