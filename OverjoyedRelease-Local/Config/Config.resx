}
.marquee-inner {
  display: inline-flex;
  white-space: nowrap;
  transform: translateX(0);
  will-change: transform;
}
.marquee-inner  span:nth-child(2) {
  display: inline-block;
  padding-left:20%;visibility:hidden;
}.marquee-inner:hover  span:nth-child(2) {
visibility:visible;
