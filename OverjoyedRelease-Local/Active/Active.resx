  <data name="pnlBaseOverlay.Html" xml:space="preserve">
    <value>&lt;style&gt;
#safeZone{visibility:hidden;}

/* IMPORTANT: allow mouse events to pass through SVG */
#outerSVG {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  --overjoyed-prompt-radius: 10px;
  --overjoyed-prompt-shadow: 5px 5px 8px black;
  --overjoyed-prompt-label-font: 12px;
  --overjoyed-prompt-eye-font: 24px;
  --overjoyed-prompt-label-padding-y: 0.8333%;
  --overjoyed-active-height: 5.5%;
  --overjoyed-active-font: 2.8vw;
  --overjoyed-active-border: 2px;
  --overjoyed-active-top: 55.1667%;
  --overjoyed-exit-border: 2px;
  --overjoyed-exit-upper-min-width: 19.6667%;
  --overjoyed-exit-upper-min-height: 8.3333%;
  --overjoyed-exit-upper-padding: 1% 2.5% 1.8333% 2.5%;
  --overjoyed-exit-middle-min-width: 19.6667%;
  --overjoyed-exit-middle-min-height: 7.6667%;
  --overjoyed-exit-lower-min-width: 19.6667%;
  --overjoyed-exit-lower-min-height: 8.3333%;
  --overjoyed-exit-arc-font: 14px;
  --overjoyed-exit-arc-letter-spacing: 1.2px;
  --overjoyed-cursor-size: 40px;
  --overjoyed-cursor-inset: 7.5%;
  --overjoyed-cursor-inner-border: 2px;
  --overjoyed-cursor-shadow-blur: 6px;
}

#outerSVG svg {
  pointer-events: none;
}

/* Prompt layer */
#promptsLayer {
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
}

#activationPromptLabelsLayer {
  position: absolute;
  inset: 0;
  z-index: 40;
  pointer-events: none;
}

#lblActiveOverlay {
  position: absolute;
  left: 0;
  top: var(--overjoyed-active-top);
  width: 100%;
  min-height: 6.5%;
  height: auto;
  font-size: var(--overjoyed-active-font);
  line-height: 1.25;
  border-top: var(--overjoyed-active-border) solid rgb(0, 167, 209);
  border-bottom: var(--overjoyed-active-border) solid rgb(0, 167, 209);
  font-family: Microsoft Sans Serif;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0.9% 2%;
  font-weight: 600;
  color: white;
  background: black;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
  cursor: default;
  box-sizing: border-box;
  z-index: 40;
}

#lblActiveOverlay[hidden] {
  display: none !important;
}

#lblActiveOverlay.overjoyed-active-state-inactive {
  top: var(--overjoyed-active-top);
  bottom: auto;
  pointer-events: none;
  background: black;
}

#lblActiveOverlay.overjoyed-active-state-active {
  top: auto;
  bottom: 0;
  pointer-events: auto;
  background: rgb(0, 167, 209);
}

.prompt-box {
  position: absolute;
  width: 8.3333%;
  height: 8.3333%;
  transform: translate(-50%, -50%);
  background: white;
  border-radius: 20%;
  box-shadow: var(--overjoyed-prompt-shadow);
  overflow: hidden;
  z-index: 10;
  display: none;
}

.prompt-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.prompt-label {
  position: absolute;
  width: 8.3333%;
  min-height: 5%;
  transform: translate(-50%, -50%);
  padding: var(--overjoyed-prompt-label-padding-y) 0;
  background: white;
  color: black;
  border-radius: 20%;
  box-shadow: var(--overjoyed-prompt-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-family: Arial, sans-serif;
  font-size: var(--overjoyed-prompt-label-font);
  line-height: 1;
  white-space: nowrap;
  z-index: 20;
  display: none;
  overflow: hidden;
}

.prompt-label.overjoyed-eye-label {
  font-size: var(--overjoyed-prompt-eye-font);
}

.prompt-box .prompt-fill {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: transparent;
  opacity: 0.92;
  pointer-events: none;
  z-index: 0;
  transition: background-image 40ms linear;
}

.prompt-box img {
  position: relative;
  z-index: 1;
}

.prompt-box.overjoyed-highlighted,
.prompt-label.overjoyed-highlighted:not(.exit-hold-label) {
  background: rgb(0, 167, 209) !important;
  color: white !important;
}

.prompt-label.exit-hold-label {
  z-index: 40;
  position: absolute;
  display: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
  transform: translate(-50%, -50%);
  background-color: black !important;
  color: white !important;
  border: var(--overjoyed-exit-border) solid rgb(0, 167, 209);
  font-weight: 700;
  padding: 1% 2%;
  border-radius: 999%;
  line-height: 1.2;
  visibility: hidden;
}

.prompt-label.exit-hold-label .exit-hold-text {
  position: relative;
  z-index: 1;
}

.prompt-label.exit-hold-label .exit-hold-text.exit-hold-multiline {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.05;
  text-align: center;
  white-space: normal;
}

.prompt-label.exit-hold-label .exit-hold-arc {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
  z-index: 1;
}

.prompt-label.exit-hold-label .exit-hold-arc text {
  fill: white;
  font-size: var(--overjoyed-exit-arc-font);
  font-weight: 700;
  letter-spacing: var(--overjoyed-exit-arc-letter-spacing);
  dominant-baseline: middle;
  alignment-baseline: middle;
}

.prompt-label.exit-hold-label.exit-hold-upper {
  min-width: var(--overjoyed-exit-upper-min-width);
  min-height: var(--overjoyed-exit-upper-min-height);
  top: 53.5% !important;
  padding: var(--overjoyed-exit-upper-padding);
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
  clip-path: polygon(50% 0, 76% 10%, 90% 30%, 100% 58%, 100% 100%, 0 100%, 0 58%, 10% 30%, 24% 10%);
  border-radius: 0;
}

.prompt-label.exit-hold-label.exit-hold-upper .exit-hold-arc {
  inset: auto;
  left: 0;
  top: 43.5%;
  width: 100%;
  height: 100%;
  transform: translateY(-50%);
}

.prompt-label.exit-hold-label.exit-hold-middle {
  min-width: var(--overjoyed-exit-middle-min-width);
  min-height: var(--overjoyed-exit-middle-min-height);
  padding: 0;
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
  border-radius: 0;
}

.prompt-label.exit-hold-label.exit-hold-lower {
  min-width: var(--overjoyed-exit-lower-min-width);
  min-height: var(--overjoyed-exit-lower-min-height);
  top: 62.5% !important;
  align-items: flex-end;
  justify-content: center;
  padding: 0;
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
  clip-path: polygon(78.32% 3.55%, 76.57% 15.60%, 72.38% 29.79%, 64.69% 43.97%, 57.00% 52.48%, 41.96% 50.35%, 32.17% 39.72%, 24.48% 17.73%, 22.38% 0%, 2.80% 0%, 0% 0.71%, 3.50% 42.55%, 10.14% 59.57%, 13.99% 75.89%, 25.52% 88.65%, 32.87% 100%, 48.25% 99.29%, 61.89% 96.45%, 80.42% 82.98%, 92.31% 51.06%, 100% 0%);
  border-radius: 0;
}

.prompt-label.exit-hold-label.exit-hold-lower .exit-hold-arc {
  inset: auto;
  left: 0;
  top: 62.5%;
  width: 100%;
  height: 100%;
  transform: translateY(-50%);
}

@keyframes overjoyedLblActiveHoldFill {
  from { background-size: 0% 100%; }
  to { background-size: 100% 100%; }
}

#lblActiveOverlay.overjoyed-lblactive-hold-fill {
  background-image: linear-gradient(90deg, rgb(0, 167, 209) 0%, rgb(0, 167, 209) 100%);
  background-repeat: no-repeat;
  background-position: left top;
  background-size: 0% 100%;
  animation: overjoyedLblActiveHoldFill 2000ms linear forwards;
}

/* Mouse Cursor */
#cursorSquare {
  position: absolute;
  width: var(--overjoyed-cursor-size);
  height: var(--overjoyed-cursor-size);
  pointer-events: none;
  z-index: 30;
}

#cursorBorder {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 var(--overjoyed-cursor-shadow-blur) rgba(0,0,0,0.6);
}

#cursorDot {
  position: absolute;
  inset: var(--overjoyed-cursor-inset);
  border-radius: 50%;
  background: rgb(0, 167, 209);
  border: var(--overjoyed-cursor-inner-border) solid black;
}

/* Socket Cursor */
#socketSquare {
  position: absolute;
  width: var(--overjoyed-cursor-size);
  height: var(--overjoyed-cursor-size);
  pointer-events: none;
  z-index: 30;
  visibility: hidden;
}

#socketBorder {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: white;
  box-shadow: 0 0 var(--overjoyed-cursor-shadow-blur) rgba(0,0,0,0.6);
}

#socketDot {
  position: absolute;
  inset: var(--overjoyed-cursor-inset);
  border-radius: 50%;
  background: rgb(0, 167, 209);
  border: var(--overjoyed-cursor-inner-border) solid black;
}

#socketSquare.glow-left, #socketSquare.glow-right, #cursorSquare.glow-left, #cursorSquare.glow-right {
  transform: scale(1.15);
}

#socketSquare.glow-left #socketDot, #cursorSquare.glow-left #cursorDot {
  background: white;
}

#socketSquare.glow-right #socketDot, #cursorSquare.glow-right #cursorDot {
  background: black;
}
&lt;/style&gt;

